# Required — set when installing for a tenant
BRAIN_URL=https://brain.your-domain.example.com
BRAIN_TENANT_TOKEN=

# Local secret used to sign session cookies
SECRET_KEY=replace-me-in-prod

# Local disk location for raw data (never leaves this server)
DATA_ROOT=/data/client

# Database sources (admin "Data sources" page). Fernet key for encrypting
# DB passwords at rest + one-time ladmin bootstrap password (hash-only,
# forced change on first login).
# CLIENT_ENCRYPTION_KEY=
# CLIENT_ENCRYPTION_KEY_OLD=
# LOCAL_ADMIN_USERNAME=ladmin
# LOCAL_ADMIN_PASSWORD=

# Tuning (optional)
# BRAIN_REQUEST_TIMEOUT=180
# MAX_FILES=5
# DB_CONNECT_TIMEOUT=8
# DB_STATEMENT_TIMEOUT=300
# DB_SNAPSHOT_CHUNK_ROWS=100000
# DB_REFRESH_TIME=00:00
# DB_REFRESH_ENABLED=1
# TZ=UTC

# Verbose brain-call debug logging to the LOCAL client log (default OFF).
# Logs BRAIN_REQUEST / BRAIN_RESPONSE per brain call (boundary-safe — no row
# values cross to the brain). Turn back OFF after diagnosing.
# CLIENT_LLM_DEBUG=0
# CLIENT_LLM_DEBUG_MAX_CHARS=20000
