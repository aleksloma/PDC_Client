# LOCAL TESTING environment for docker-compose.local.yml.
# Copy to `client.local.env` and fill in. NEVER commit the filled-in file
# (*.env is gitignored).

# The locally-composed brain (PDC_Brain repo, docker-compose.local.yml).
BRAIN_URL=http://host.docker.internal:8090

# Token of a tenant that exists in the local brain's pdc_brain_data volume.
BRAIN_TENANT_TOKEN=

# Keep this STABLE across rebuilds so existing sessions survive (use the
# same value the previous local stack ran with).
# REQUIRED (>= 32 characters; the app refuses to start without it):
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATA_ROOT=/data/client

# Local stack is plain HTTP on a host port, so the session cookie must not be
# Secure-only. Customer installs keep the default (true) and front the
# container with TLS.
SESSION_HTTPS_ONLY=false

# Data sources (DB tables) — generate once and keep stable across rebuilds
# so stored DB passwords survive:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLIENT_ENCRYPTION_KEY=

# One-time ladmin bootstrap password (ignored once ladmin has a password).
LOCAL_ADMIN_PASSWORD=

# Analysis sandbox. Generated Python runs in the pdc-executor container, which
# docker-compose.local.yml builds and starts alongside this one. `up -d
# --build` brings up both services and the web container waits for the sandbox
# to report healthy, so the local stack answers questions the same way a
# customer install does.
#
# The topology is set in docker-compose.local.yml, where compose `environment`
# overrides `env_file`, so these stay commented here and setting them has no
# effect: EXECUTOR_URL=http://pdc-executor:8090, EXECUTOR_SHARED_DIR=/jobs,
# EXECUTOR_MAX_CONCURRENT=1 and EXECUTOR_NETWORK_CIDR (fed by
# PDC_BACKEND_SUBNET, default 192.168.255.240/28; override it in your shell
# if that range collides with something on your host).
# EXECUTOR_URL=http://pdc-executor:8090
# EXECUTOR_SHARED_DIR=/jobs

# Answer templates: the features this client announces to the brain on
# /v1/plan and /v1/retry (comma-separated). Default narrative_v1,diagnostics_v1:
# the AI writes the answer as a template and this client fills in the numbers
# locally, so no computed value is sent to the brain. Only those two names are
# recognised (two_phase_v1 is ignored in this release); diagnostics_v1 needs
# narrative_v1. Set it EMPTY (`BRAIN_CAPABILITIES=`) to switch the feature off;
# the brain then answers as before (restart the web container after a
# change). The value scrubs (no result preview, no profile min/max or top
# values, scrubbed error text) apply either way.
# BRAIN_CAPABILITIES=narrative_v1,diagnostics_v1
