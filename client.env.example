# PowerDataChat Client — customer install environment template
#
# Copy this file to `client.env` and fill in the two required secrets
# (BRAIN_TENANT_TOKEN, SECRET_KEY). NEVER commit the filled-in `client.env`.
#
# The client runs inside YOUR network. Raw data, chats, and rendered decks stay
# on your server in DATA_ROOT; no uploaded file, result table, or rendered chart
# is ever transmitted. CUSTOMER_INSTALL.md lists exactly what does cross to the
# PowerDataChat brain.

# --- Required ---------------------------------------------------------------

# URL of the PowerDataChat-hosted brain. Set to the endpoint PowerDataChat gave
# you (this placeholder is not a live URL).
BRAIN_URL=https://brain.your-domain.example.com

# Per-tenant bearer token. Paste the token from the PowerDataChat admin panel —
# it is shown ONCE at tenant creation. One token per customer.
BRAIN_TENANT_TOKEN=

# Session cookie signing secret. Generate ONCE with:
#     openssl rand -hex 32
# Keep it stable across restarts so user logins persist (changing it logs
# everyone out).
SECRET_KEY=

# Encryption key for database-connection passwords stored at rest (the
# "Data sources" feature). Required if you register database tables.
# Generate ONCE with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes stored DB passwords unreadable — they must be
# re-entered in the admin UI (or put the previous key in
# CLIENT_ENCRYPTION_KEY_OLD while rotating).
CLIENT_ENCRYPTION_KEY=
# CLIENT_ENCRYPTION_KEY_OLD=

# One-time bootstrap password for the local admin account "ladmin" (the only
# account that can manage database sources). Only a HASH is stored; the admin
# is forced to change it on first login. Once ladmin exists this variable is
# ignored (an existing password is never overwritten).
LOCAL_ADMIN_PASSWORD=

# --- Storage ----------------------------------------------------------------

# Filesystem root for all client state (users, chats, uploads, rendered decks).
# Mount a PERSISTENT volume here — raw data lives here and never leaves your
# server. See CUSTOMER_INSTALL.md for the `-v` / compose volume mapping.
DATA_ROOT=/data/client

# --- Session security -------------------------------------------------------

# Mark the session cookie Secure so browsers send it only over HTTPS.
# DEFAULT TRUE — keep it that way and put the container behind your own TLS
# terminator. Set it to false ONLY for plain-HTTP local development or an
# isolated evaluation LAN: sessions then travel unencrypted and can be
# captured. (Browsers exempt http://localhost, so a laptop test works either
# way.)
# SESSION_HTTPS_ONLY=true

# --- Optional (uncomment to override defaults) ------------------------------

# Application log rotation. The log lives at <DATA_ROOT>/logs/datachat.log
# (/data/client/logs/datachat.log in the container, i.e. on the persistent data
# volume). Defaults: 50 MB per file, 5 rotated backups kept.
# LOG_MAX_BYTES=52428800
# LOG_BACKUP_COUNT=5

# Max files per upload session (default 10).
# MAX_FILES=10

# Direct-to-GCS large-file upload hop — LEAVE UNSET on a customer install.
# Only for a deployment behind an ingress that caps request bodies (the
# PowerDataChat Cloud Run demo). Unset: /upload/init + /upload/finalize answer
# 400 and every file goes through multipart /upload.
# GCS_UPLOAD_BUCKET=

# Per-request timeout (seconds) for calls to the brain (default 120).
# BRAIN_REQUEST_TIMEOUT=120

# Tighter cap (seconds) for the AI description draft during table
# registration — it runs behind an admin click, so a stalled brain must fail
# by name rather than hold the dialog (default 60).
# BRAIN_DRAFT_TIMEOUT=60

# Container timezone — the nightly database-snapshot refresh runs at the
# admin-configured time in THIS timezone (default UTC).
# TZ=Europe/Berlin

# Local admin username (default "ladmin").
# LOCAL_ADMIN_USERNAME=ladmin

# Database connector tuning (defaults shown).
# DB_CONNECT_TIMEOUT=8            # seconds per connection attempt
# DB_STATEMENT_TIMEOUT=300        # seconds per snapshot query
# DB_SNAPSHOT_CHUNK_ROWS=100000   # rows per pd.read_sql chunk
# DB_REFRESH_TIME=00:00           # first-boot default; admin UI value wins
# DB_REFRESH_ENABLED=1

# In-memory dataframe cache budget (MB). Raise on installs with large
# database-table snapshots so refreshed questions stay fast (default 500).
# DF_CACHE_MAX_MB=500
